{
  "name": "sanguosha-minimal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @sgs/web dev",
    "server:dev": "pnpm --filter @sgs/server dev",
    "server:start": "pnpm --filter @sgs/server start",
    "build": "pnpm --filter @sgs/engine build && pnpm --filter @sgs/web build && pnpm --filter @sgs/server build",
    "test": "pnpm --filter @sgs/engine test && pnpm --filter @sgs/server test",
    "stress:500": "pnpm --filter @sgs/engine exec vitest run tests/phase6.stress.test.ts",
    "test:coverage": "pnpm --filter @sgs/engine test:coverage",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
